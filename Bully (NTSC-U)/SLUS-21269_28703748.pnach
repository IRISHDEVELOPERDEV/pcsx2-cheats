gametitle=Bully (NTSC-U) [SLUS-21269] 28703748
// PCSX2 cheats for the USA disc only (CRC 28703748).
// Source: CheatDevicePS2 code list, converted to pnach by xs1l3n7x. Multi-line codes that the conversion split into several
//   same-named sections are merged back into one section here (patch lines unchanged, same order).
// [JOKER] = button-activated. [MASTER CODE] = Cheat Device hook, not needed in PCSX2; leave it off.
// Most of this file is Stats-screen counters (Max/No pairs); never enable a Max and a No version of the same stat together.
// Status: [UNTESTED] = not yet confirmed in game. Enable one cheat at a time when trying them.

[Phoenix Key]
author=CheatDevicePS2 (codes), xs1l3n7x (pnach conversion)
description=[UNTESTED] [MASTER CODE - leave OFF] CodeBreaker/Cheat Device hook code (type 9). PCSX2 does not need it; not a gameplay cheat.
patch=1,EE,901216F8,extended,00832021

[Infinite Health]
author=CheatDevicePS2 (codes), xs1l3n7x (pnach conversion)
description=[TESTED] Health stays at 200. Direct write.
patch=1,EE,21C68AC8,extended,43480000

[Infinite Health (Alternate)]
author=CheatDevicePS2 (codes), xs1l3n7x (pnach conversion)
description=[UNTESTED] [CODE CAVE + HOOK] Health refilled by a hook at 0x0041F568 (cave 0x000C0220). Do not combine with Infinite Health.
patch=1,EE,200C0220,extended,3C014348
patch=1,EE,200C0224,extended,AE8119F4
patch=1,EE,200C0228,extended,AE811A08
patch=1,EE,200C022C,extended,03E00008
patch=1,EE,200C0230,extended,C68219F4
patch=1,EE,2041F568,extended,0C030088

