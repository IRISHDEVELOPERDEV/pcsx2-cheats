gametitle=Grand Theft Auto: Vice City Stories (PAL, En/Fr/De/Es/It) [SLES-54622] B3AD1EA4
// PCSX2 cheats for the European/Australian disc only (CRC B3AD1EA4).
// Sources: GameHacking.org PAL list by luc-ita (https://gamehacking.org/game/110916);
// Infinite Ammo, Max Money and 9999-ammo idea ported from NTSC raw codes by Azagthoth (GTAForums topic 442950);
// custom code-cave cheats made for this pack. All addresses checked against the PAL ELF SLES_546.22.
// Status: [TESTED] = verified in game memory on PCSX2 while running (Nov 4 2026). [UNTESTED] = not yet confirmed. Enable one cheat at a time when trying untested ones.

[Infinite Health and Armour]
author=luc-ita (GameHacking.org, PAL)
description=[TESTED] Refills player health and armour to 500 every frame (HUD routine). Code patch.
patch=1,EE,2031E650,extended,3C0143FA
patch=1,EE,2031E660,extended,E44104E4
patch=1,EE,2031E664,extended,E44104E8
patch=1,EE,2031E66C,extended,00000000

[Infinite Ammo (on foot and in vehicles)]
author=Azagthoth (NTSC), ported to PAL (+0x1D8)
description=[TESTED] Ammo and clip never go down. Code patch: addiu v0,v0,-1 -> addiu v0,v0,0.
patch=1,EE,202C1A64,extended,24420000
patch=1,EE,202C1AC8,extended,24420000
patch=1,EE,202C1E6C,extended,24420000
patch=1,EE,202C1ED4,extended,24420000

[Max Money]
author=Azagthoth (NTSC), ported to PAL (+0x300)
description=[TESTED] Sets cash and displayed cash to $99,999,999. Static player-info address; is saved to the memory card.
patch=1,EE,204E4CCC,extended,05F5E0FF
patch=1,EE,204E4CD0,extended,05F5E0FF

[Never Wanted]
author=luc-ita (GameHacking.org, PAL)
description=[TESTED] Wanted level always stays at zero. Code patch.
patch=1,EE,203AAB10,extended,10000052

[Infinite Sprint (and swim stamina)]
author=luc-ita (GameHacking.org, PAL)
description=[TESTED] Running/swimming never tires. Code patch.
patch=1,EE,20232C1C,extended,1000000E

[Infinite Oxygen Underwater]
author=luc-ita (GameHacking.org, PAL)
description=[TESTED] Breath meter never drains while swimming. Code patch.
patch=1,EE,201F3144,extended,00000000

[Never Fall Off Bike]
author=luc-ita (GameHacking.org, PAL)
description=[TESTED] You are not thrown off motorbikes/bicycles. Code patch.
patch=1,EE,20336D60,extended,10000006
patch=1,EE,201DB864,extended,10000021

[Player Car Indestructible (EXPERIMENTAL)]
author=luc-ita (GameHacking.org, PAL) - author says "read notes"
description=[UNTESTED] [EXPERIMENTAL - may crash] Car you drive gets 90000 health; also writes 90000 to two physics fields (+0xD0/+0xD4, probably mass), so it will feel very heavy. Skips part of the damage routine. Test on its own.
patch=1,EE,20137884,extended,3C0347AF
patch=1,EE,20137888,extended,3463C800
patch=1,EE,2013788C,extended,AE43027C
patch=1,EE,20137890,extended,AE4300D0
patch=1,EE,20137894,extended,AE4300D4
patch=1,EE,20137898,extended,1000002F

[Always Clear Weather (EXPERIMENTAL)]
author=luc-ita (GameHacking.org, PAL)
description=[UNTESTED] [EXPERIMENTAL - may crash] Forces clear weather.
patch=1,EE,104CD908,extended,00000000
patch=1,EE,203E3AB4,extended,00000000

[Auto Weapon Sets (all three)]
author=IRISHDEVELOPERDEV (PAL SLES-54622), uses the game's own weapon-set cheat routines
description=[TESTED] About 5 s after you are in control (and again after death/arrest/weapons removed), runs built-in Weapon Sets 1, 2, 3 once if your heavy-weapon slot is empty. Code cave 0x000C3000-0x000C30BF, counter at 0x000C3100; hook at 0x003BAD8C (DoCheats call in game loop).
