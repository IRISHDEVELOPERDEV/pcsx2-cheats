gametitle=Grand Theft Auto: San Andreas (PAL v2.01, En/Fr/De/Es/It) [SLES-52541] B440A8FE
// PCSX2 cheats for the European/Australian v2.01 disc only (CRC B440A8FE).
// Mostly custom codes that switch on the game's own cheat flags or write its stat/money fields; addresses checked against the v2.01 ELF.
// The Infinite Health and Armour HUD hook is adapted from a Codejunkies v1 code.
// Status: [UNTESTED] = not yet confirmed in game. Enable one cheat at a time when trying them.

[Infinite Health and Armour]
author=IRISHDEVELOPERDEV (custom, addresses checked against the v2.01 ELF; HUD hook adapted from Codejunkies v1 code)
description=[TESTED] Keeps CJ at 100 health and 100 armour (refilled by the HUD every frame) and turns on the game's own BAGUVIX bullet-proof flag. Player only.
patch=1,EE,0088E3BD,extended,00000001
patch=1,EE,202A9CD8,extended,3C0142C8
patch=1,EE,202A9CDC,extended,AC610588
patch=1,EE,202A9CE0,extended,AC610580
patch=1,EE,202A9CE4,extended,24030064
patch=1,EE,202A9D30,extended,3C0142C8
patch=1,EE,202A9D34,extended,AC610588
patch=1,EE,202A9D38,extended,AC610580
patch=1,EE,202A9D3C,extended,24030064

[Max Money]
author=IRISHDEVELOPERDEV (custom, CPlayerInfo money field found from the game's own money cheat)
description=[TESTED] Money stays at $99,999,999. Writes the money value directly, so it is saved to the memory card.
patch=1,EE,2070A344,extended,05F5E0FF
patch=1,EE,2070A348,extended,05F5E0FF

[Infinite Ammo]
author=IRISHDEVELOPERDEV (custom, game's own FULLCLIP cheat flag)
description=[TESTED] Infinite ammo, no reloading.
patch=1,EE,0088E3C8,extended,00000001

[Never Wanted]
author=IRISHDEVELOPERDEV (custom, game's own AEZAKMI cheat flag)
description=[TESTED] Wanted level can't change, so you never get stars.
patch=1,EE,0088E3C1,extended,00000001

[Never Hungry]
author=IRISHDEVELOPERDEV (custom, game's own never-hungry cheat flag)
description=[TESTED] CJ never gets hungry or loses weight/muscle from hunger.
patch=1,EE,0088E3C4,extended,00000001

[Max Respect]
author=IRISHDEVELOPERDEV (custom, game's own max-respect cheat flag)
description=[TESTED] Respect is always maxed.
patch=1,EE,0088E3CF,extended,00000001

[Max Stamina - Infinite Sprint]
author=IRISHDEVELOPERDEV (custom, CStats float table, stat 22)
description=[TESTED] Stamina stat held at 1000, so CJ can sprint, swim and cycle without tiring.
patch=1,EE,20802E48,extended,447A0000

[Max Vehicle Skills]
author=IRISHDEVELOPERDEV (custom, CStats int table, stats 160/223/229/230)
description=[TESTED] Driving, flying, bike and cycling skills held at max (1000).
patch=1,EE,20802FE0,extended,000003E8
patch=1,EE,2080309C,extended,000003E8
patch=1,EE,208030B4,extended,000003E8
patch=1,EE,208030B8,extended,000003E8

[Max Weapon Skills - Hitman]
author=IRISHDEVELOPERDEV (custom, CStats float table, stats 69-79)
description=[TESTED] All weapon skills at Hitman level (1000). Pistols, sawn-off and Uzi/Tec9 become dual-wield.
