patch=1,EE,200C0128,extended,24840008
patch=1,EE,200C012C,extended,080A3EF4
patch=1,EE,200C0130,extended,C4400008
patch=1,EE,200C0180,extended,C96BA6EB // respect_level
patch=1,EE,200C0184,extended,42480000
patch=1,EE,200C0188,extended,01F24959 // melee_level (Fighting)
patch=1,EE,200C018C,extended,41200000
patch=1,EE,200C0190,extended,57B16748 // shooting_level (Shooting)
patch=1,EE,200C0194,extended,41200000
patch=1,EE,200C0198,extended,D5FC1905 // defense_level (Health/Toughness)
patch=1,EE,200C019C,extended,41200000
patch=1,EE,200C01A0,extended,6C62528C // speed_level (Speed)
patch=1,EE,200C01A4,extended,41200000
patch=1,EE,200C01A8,extended,D878E3E4 // Street Smarts level
patch=1,EE,200C01AC,extended,41200000
patch=1,EE,2028FBCC,extended,08030040 // hook: was C4400008 lwc1 $f0,8($v0)

[Police Heat Never Increases]
author=IRISHDEVELOPERDEV (custom, built and checked against the PAL ELF SLES_539.67; no Codejunkies/CodeBreaker heat code exists for this game)
description=[UNTESTED] Police heat (the "Crimewatch" meter) can never go up in any neighbourhood, so crimes don't raise your wanted level and cops don't come after you for it. Heat can still go DOWN normally (cooling off, bribes), so any heat you already have will fade or can be bribed away.
// The game's single SetHeat routine (0x0029C460) is used by both AddHeat (0x0029C8C8) and SetHeatLevel (0x0029C7F8).
// It computes delta = new - current and returns early if delta == 0 (c.eq.s $f20,$f0 at 0x0029C528, then bc1t to the exit).
// Patched to c.le.s $f0,$f20 so it also returns early whenever delta > 0: increases are dropped, decreases still apply.
patch=1,EE,2029C528,extended,46140036

[Police Heat Always Zero]
author=IRISHDEVELOPERDEV (custom, built and checked against the PAL ELF SLES_539.67)
description=[UNTESTED] [OLD VERSION - possible freeze, use the (Safe) version instead] Wipes police heat to zero in every neighbourhood, every frame, including heat already in your save. Uses the game's own heat-setting routine, so the heat stars/HUD update and the game is told the heat level dropped. Best used together with "Police Heat Never Increases" (keeps it from flickering up between frames).
// Hook: 0x0029C130 = Crimewatch manager message handler (only reached via its vtable slot at 0x005AACCC; no branches into 0x0029C130/34).
//   Original first instruction 27BDFF90 (addiu $sp,$sp,-0x70) is replaced by j 0x000C0300 and re-executed at the end of the cave.
// Cave 0x000C0300-0x000C03C8: saves $ra,$s0-$s2,$a0-$a3 (sq, 128-bit) on its own stack frame; only acts when the message is the
//   per-frame update message (*(a1) == *(0x006125F8), same check the game uses, dt 1/60) and this == Crimewatch manager (*(0x0059A25C)).
//   For each of the 11 neighbourhood entries (mgr+0x28+i*0x54, heat float at +0x1C) with heat > 0 it calls
//   SetHeat(mgr, i, 0.0f, a2=0 (show HUD change), a3=0 (no rounding), t0=0) at 0x0029C460, then restores registers and resumes.
patch=1,EE,200C0300,extended,27BDFF80
patch=1,EE,200C0304,extended,FFBF0000
patch=1,EE,200C0308,extended,7FB00010
patch=1,EE,200C030C,extended,7FB10020
