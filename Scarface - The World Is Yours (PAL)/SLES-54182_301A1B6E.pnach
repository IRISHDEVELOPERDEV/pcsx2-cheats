gametitle=Scarface: The World Is Yours (PAL, En/Fr/Es/It) [SLES-54182] 301A1B6E
// PCSX2 cheats for the European disc only (CRC 301A1B6E).
// Source: Codejunkies Action Replay codes (via the European CodeBase), converted to pnach.
// Status: [UNTESTED] = not yet confirmed in game. Enable one cheat at a time when trying them.

[Infinite Health]
author=Codejunkies (via European CodeBase)
description=[TESTED] Player health never goes down (sets a game flag).
patch=1,EE,008099A4,extended,00000001

[Infinite Ammo]
author=Codejunkies (via European CodeBase)
description=[TESTED] Ammo never goes down. Code patch.
patch=1,EE,203CE7F4,extended,00000000

[No Car Damage]
author=Codejunkies (via European CodeBase)
description=[UNTESTED] Cars you drive take no damage. Code patch.
